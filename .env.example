# Variables requeridas por la aplicación
AUTH_SECRET=
DATABASE_URL=

# Requeridas para enviar correos de cuenta, pedidos y reportes de problemas
API_KEY_BREVO=
BREVO_SENDER_EMAIL=

# Requerida para proteger el endpoint de reintentos de avisos de pedidos.
CRON_SECRET=

# Opcional: carga firmada en servidor de una foto de producto a Cloudinary.
# Configura CLOUDINARY_URL o las tres variables CLOUDINARY_* por separado.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Requerida solo para la verificación inicial del webhook de Meta
META_WEBHOOK_VERIFY_TOKEN=

# Solo para pruebas locales de integración/E2E; nunca uses la base de producción
TEST_DATABASE_URL=
