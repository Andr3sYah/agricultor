generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  PRODUCER
  BUYER
  TRADER
  ASSOCIATION
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProductPricingType {
  FIXED
  NEGOTIABLE
}

enum OrderNotificationType {
  REQUEST_CREATED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
}

enum OrderNotificationStatus {
  PENDING
  SENDING
  SENT
  RETRY
  FAILED
  UNKNOWN
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  userRoles     UserRole[]
  products      Product[]
  productPriceChanges ProductPriceChange[] @relation("ProductPriceChangeActor")
  favorites     Favorite[]
  buyerOrders   Order[]        @relation("OrderBuyer")
  producerOrders Order[]       @relation("OrderProducer")
  orderHistory  OrderHistory[]
  farmActivities FarmActivity[]
  sellerProfile SellerProfile?
  paymentEvents OrderPaymentEvent[] @relation("PaymentEventActor")
}

model SellerProfile {
  id          String  @id @default(cuid())
  ownerId     String  @unique
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(80)
  description String  @db.VarChar(600)
  municipality String @db.VarChar(100)
  neighborhood String? @db.VarChar(100)
  exactLocation String? @db.VarChar(240)
  exactLocationPublic Boolean @default(false)
  exactLocationConsentAt DateTime? @db.Timestamp(3)
  published   Boolean @default(false)
  whatsapp    String? @db.VarChar(12)
  whatsappLink String? @db.VarChar(64)
  whatsappPublic Boolean @default(false)
  phone       String? @db.VarChar(12)
  phonePublic Boolean @default(false)
  email       String? @db.VarChar(254)
  emailPublic Boolean @default(false)
  publicContactConsentAt DateTime? @db.Timestamp(3)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserRole {
  userId    String
  role      RoleName
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Product {
  id                    String   @id @default(cuid())
  ownerId               String
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String   @db.VarChar(100)
  category              String   @db.VarChar(40)
  availableQuantity     Decimal  @db.Decimal(12, 3)
  reservedQuantity      Decimal  @default(0) @db.Decimal(12, 3)
  unit                  String   @db.VarChar(30)
  priceCOP              Int?
  pricingType           ProductPricingType @default(FIXED)
  municipality          String   @db.VarChar(100)
  isPublished           Boolean  @default(false)
  priceReferenceEnabled Boolean  @default(false)
  priceReferenceConsentAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  orders                Order[]
  favorites             Favorite[]
  priceChanges          ProductPriceChange[]

  @@index([ownerId, updatedAt])
}

model ProductPriceChange {
  id         String   @id @default(cuid())
  productId  String
  actorId    String
  oldPriceCOP Int
  newPriceCOP Int
  source     String   @db.VarChar(40)
  observedAt DateTime @db.Timestamp(3)
  appliedAt  DateTime @default(now()) @db.Timestamp(3)
  reason     String   @db.VarChar(120)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor      User     @relation("ProductPriceChangeActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([productId, appliedAt])
  @@index([actorId, appliedAt])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model Order {
  id                 String      @id @default(cuid())
  buyerId            String
  producerId         String
  productId          String?
  idempotencyKey     String?
  productName        String      @db.VarChar(100)
  requestedQuantity  Decimal     @db.Decimal(12, 3)
  unit               String      @db.VarChar(30)
  priceCOP           Int
  status             OrderStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  decidedAt          DateTime?
  buyer              User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  producer           User        @relation("OrderProducer", fields: [producerId], references: [id], onDelete: Cascade)
  product            Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  history            OrderHistory[]
  sellerContact      OrderSellerContact?
  deliveryDetails    OrderDeliveryDetails?
  receipt            OrderReceipt?
  paymentReceipt     OrderPaymentReceipt?
  paymentEvents      OrderPaymentEvent[]
  notifications      OrderNotification[]

  @@index([buyerId, createdAt])
  @@index([producerId, status, createdAt])
  @@index([productId])
  @@unique([buyerId, idempotencyKey])
}

model OrderNotification {
  id            String                  @id @default(cuid())
  orderId       String
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          OrderNotificationType
  status        OrderNotificationStatus @default(PENDING)
  attempts      Int                     @default(0)
  claimToken    String?                 @db.VarChar(36)
  nextAttemptAt DateTime                @default(now())
  sentAt        DateTime?
  lastErrorCode String?                 @db.VarChar(60)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([orderId, type])
  @@index([status, nextAttemptAt])
}

model OrderPaymentReceipt {
  orderId     String   @id
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String   @db.VarChar(16)
  amountCOP   BigInt
  confirmedAt DateTime @default(now())
}

model OrderPaymentEvent {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId           String
  actor             User     @relation("PaymentEventActor", fields: [actorId], references: [id], onDelete: Cascade)
  provider          String   @db.VarChar(16)
  method            String   @db.VarChar(16)
  externalReference String?  @db.VarChar(120)
  amountCOP         BigInt
  currency          String   @default("COP") @db.Char(3)
  status            String   @db.VarChar(16)
  idempotencyKey    String   @db.VarChar(100)
  createdAt         DateTime @default(now())

  @@unique([orderId, idempotencyKey])
  @@index([orderId, createdAt])
}

model OrderReceipt {
  orderId    String   @id
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedAt DateTime @default(now())
  rating     Int?
}

model OrderDeliveryDetails {
  orderId String @id
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  String @db.VarChar(8)
  when    String @db.VarChar(100)
  place   String @db.VarChar(240)
  costCOP Int
  confirmation OrderDeliveryConfirmation?
}

model OrderDeliveryConfirmation {
  orderId     String               @id
  delivery    OrderDeliveryDetails @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  confirmedAt DateTime             @default(now())
  payment     OrderExternalPayment?
}

model OrderExternalPayment {
  orderId      String                    @id
  confirmation OrderDeliveryConfirmation @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  method       String                    @db.VarChar(16)
  wompiUrl     String?                   @db.VarChar(250) @unique
}

model OrderSellerContact {
  orderId  String @id
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  whatsapp String @db.VarChar(12)
}

model OrderHistory {
  id         String      @id @default(cuid())
  orderId    String
  actorId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum FarmActivityType {
  SOWING
  IRRIGATION
  FERTILIZATION
  HARVEST
  OTHER
}

model FarmActivity {
  id            String            @id @default(cuid())
  userId        String
  activityType  FarmActivityType
  scheduledFor  DateTime          @db.Date
  cropProduct   String?           @db.VarChar(100)
  notes         String?           @db.VarChar(1000)
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
